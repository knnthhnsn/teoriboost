{
  "hosting": {
    "target": "team",
    "public": "dist/public",
    "ignore": [
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/assets/voice/jeppe-neural-v1/:path*",
        "destination": "https://app.teoriboost.dk/assets/voice/jeppe-neural-v1/:path",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "teoriboost-api",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|mjs|css|html|json|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
